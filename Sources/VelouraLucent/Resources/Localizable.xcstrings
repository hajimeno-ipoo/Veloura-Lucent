    "%@ではRMSに対するピークの比率が±0.05 dB以内で維持されています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, the ratio of peaks to RMS stayed within ±0.05 dB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ではRMSに対するピークの比率が±0.05 dB以内で維持されています。"
          }
        }
      }
    },
    "%@ではRMSに対するピークの比率が増え、瞬間成分が相対的に大きい構造へ変化しています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, the ratio of peaks to RMS increased, making transient content relatively more prominent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ではRMSに対するピークの比率が増え、瞬間成分が相対的に大きい構造へ変化しています。"
          }
        }
      }
    },
    "%@ではRMSに対するピークの比率が減り、瞬間成分と平均成分の差が小さい構造へ変化しています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, the ratio of peaks to RMS decreased, reducing the difference between transient and average content."
