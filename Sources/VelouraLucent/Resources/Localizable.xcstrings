    "最終版の音量、安全上限、強弱の残し方、仕上げの効き方を決めます。測定値は事故防止の目安で、最終判断は試聴で行います。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the final loudness, peak ceiling, dynamic range, and finishing intensity. Measurements help prevent problems; use listening for the final decision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終版の音量、安全上限、強弱の残し方、仕上げの効き方を決めます。測定値は事故防止の目安で、最終判断は試聴で行います。"
          }
        }
      }
    },
    "最終版の音量感、明るさ、押し出し方の出発点です。配信用、安全重視、音圧重視など、仕上げたい方向に合わせて選びます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A starting point for the final loudness, brightness, and presence. Choose a profile that matches your goal, such as streaming, headroom, or higher loudness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終版の音量感、明るさ、押し出し方の出発点です。配信用、安全重視、音圧重視など、仕上げたい方向に合わせて選びます。"
          }
        }
      }
    },
