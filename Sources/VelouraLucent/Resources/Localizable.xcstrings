            "value": "基音・倍音・50/60 Hz付近の音程成分・低域位相"
          }
        }
      }
    },
    "場面ごとの音量感です。入力、%@、最終版を同じ基準で比べます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows perceived loudness over time. Compare the input, %@, and final version on the same scale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場面ごとの音量感です。入力、%@、最終版を同じ基準で比べます。"
          }
        }
      }
    },
    "増えています": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "increased"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "増えています"
          }
        }
      }
    },
    "増えると刺さりやすい。下げすぎると声が丸くなる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More can sound harsh; reducing too much can dull vocals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "増えると刺さりやすい。下げすぎると声が丸くなる"
          }
        }
      }
    },
    "声の息感まで丸くなる場合があります": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocal breath may also become dull"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の息感まで丸くなる場合があります"
          }
        }
      }
    },
    "声の芯": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocal body"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の芯"
          }
        }
      }
    },
    "声や主旋律が前に出る帯域を補う量です。補正で引っ込みすぎた時に戻します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores the range that brings vocals and lead melodies forward when correction has recessed them too much."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声や主旋律が前に出る帯域を補う量です。補正で引っ込みすぎた時に戻します。"
          }
        }
      }
    },
    "声や主旋律が前に出る感じに関わる帯域です。上げるほど明瞭になりますが、上げすぎると耳に近く感じる場合があります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The range that brings vocals and lead melodies forward. Raising it adds clarity, but too much can sound overly close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声や主旋律が前に出る感じに関わる帯域です。上げるほど明瞭になりますが、上げすぎると耳に近く感じる場合があります。"
          }
        }
      }
    },
    "声や主旋律の中心になる帯域を守る量です。上げるほど音の中心が細くなりにくくなります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls protection for the range that carries vocals and lead melodies. Higher values help keep their core from thinning out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声や主旋律の中心になる帯域を守る量です。上げるほど音の中心が細くなりにくくなります。"
          }
        }
      }
    },
    "声や主旋律の中心帯域を整える処理です。前に出る感じと聞きやすさに関わります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evens out the core range of vocals and lead melodies, affecting presence and listening comfort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声や主旋律の中心帯域を整える処理です。前に出る感じと聞きやすさに関わります。"
          }
        }
      }
    },
    "変動を保つ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve variation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変動を保つ"
          }
        }
      }
    },
    "変動幅": {
