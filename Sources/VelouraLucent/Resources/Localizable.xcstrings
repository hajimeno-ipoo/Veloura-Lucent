          }
        }
      }
    },
    "高域のチラつき": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-Frequency Flutter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域のチラつき"
          }
        }
      }
    },
    "高域の不足を別の帯域情報から補う量です。上げるほど高域の伸びを戻しますが、不自然な明るさが出る場合があります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores missing high frequencies using information from other bands. Higher values extend the highs but can sound unnaturally bright."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域の不足を別の帯域情報から補う量です。上げるほど高域の伸びを戻しますが、不自然な明るさが出る場合があります。"
          }
        }
      }
    },
    "高域の余韻": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-frequency decay"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域の余韻"
          }
        }
      }
    },
    "高域の検出、帯域別の圧縮、ステレオ幅、倍音の濃さを調整します。音の印象が大きく変わるため、必要な時だけ触る設定です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust high-frequency detection, multiband compression, stereo width, and harmonic density. These controls can change the sound substantially, so use them when needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域の検出、帯域別の圧縮、ステレオ幅、倍音の濃さを調整します。音の印象が大きく変わるため、必要な時だけ触る設定です。"
          }
        }
      }
    },
    "高域の耳障りさの指標です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A measure of harshness in high frequencies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域の耳障りさの指標です。"
          }
        }
      }
    },
    "高域の自然さ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High frequency naturalness"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域の自然さ"
          }
        }
      }
    },
    "高域の良し悪しは増減量だけでは確定できません。刺さり、ヒス、煌びやかさ、空気感は別の性質として試聴確認が必要です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A change in high-frequency level alone does not establish its quality. Harshness, hiss, brightness, and air are different qualities that require listening."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高域の良し悪しは増減量だけでは確定できません。刺さり、ヒス、煌びやかさ、空気感は別の性質として試聴確認が必要です。"
          }
        }
      }
    },
