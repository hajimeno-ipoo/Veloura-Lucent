    "クリップ検出数は入力%@、処理後%@です。測定値だけでは水中感、金属的な揺れ、残響分離などは判定できません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipped sample counts are %@ for the input and %@ after processing. Measurements alone cannot identify watery sound, metallic modulation, or reverberation separation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップ検出数は入力%@、処理後%@です。測定値だけでは水中感、金属的な揺れ、残響分離などは判定できません。"
          }
        }
      }
    },
    "クレストファクターは%@→%@、ステレオ相関は%@→%@です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crest factor changed from %@ to %@, and stereo correlation from %@ to %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレストファクターは%@→%@、ステレオ相関は%@→%@です。"
          }
        }
      }
    },
    "クレストファクターは%@→%@、差は%@です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crest factor changed from %@ to %@, a difference of %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレストファクターは%@→%@、差は%@です。"
          }
        }
      }
    },
    "クレストファクターは%@、短時間RMSの95％点と10％点の差は%@、Peak-to-Loudness Ratioは%@です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crest factor is %@, the difference between the 95th and 10th percentiles of short-term RMS is %@, and Peak-to-Loudness Ratio is %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレストファクターは%@、短時間RMSの95％点と10％点の差は%@、Peak-to-Loudness Ratioは%@です。"
          }
        }
      }
