          }
        }
      }
    },
    "左右の広がりや位相の違いを守る量です。上げるほど補正で広がりが崩れにくくなります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protects stereo width and phase differences. Higher values help correction preserve the sense of space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の広がりや位相の違いを守る量です。上げるほど補正で広がりが崩れにくくなります。"
          }
        }
      }
    },
    "左右の音がどれくらい同じ向きで鳴っているかを見る指標です。0より下はモノラル再生で音が痩せる可能性があります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how closely the left and right channels move together. Values below zero may sound thin in mono playback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の音がどれくらい同じ向きで鳴っているかを見る指標です。0より下はモノラル再生で音が痩せる可能性があります。"
          }
        }
      }
    },
    "左右への広がり具合です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How widely the sound spreads between left and right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右への広がり具合です。"
          }
        }
      }
    },
    "左右への広がり具合です。今の実装では低域を広げず、中高域を中心に広がりを調整します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls stereo width. The current processing adjusts mainly the mid and high frequencies without widening the low end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右への広がり具合です。今の実装では低域を広げず、中高域を中心に広がりを調整します。"
          }
        }
      }
    },
    "左右への広がり具合です。入力、%@、最終版を切り替えて変化を確認します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows stereo spread. Switch between Input, %@, and Final to compare changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右への広がり具合です。入力、%@、最終版を切り替えて変化を確認します。"
          }
        }
      }
    },
    "左右チャンネルの瞬間的な関係を点や線で表示します。縦に近いほど同相、横に広がるほど逆相成分が多く、斜め方向は左右どちらかへ偏った状態を示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the momentary relationship between the left and right channels as points and lines. A more vertical shape indicates in phase audio; a wider horizontal shape indicates more out of phase content; diagonal movement indicates a bias toward one side."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右チャンネルの瞬間的な関係を点や線で表示します。縦に近いほど同相、横に広がるほど逆相成分が多く、斜め方向は左右どちらかへ偏った状態を示します。"
          }
        }
      }
    },
    "左右差": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "left right difference"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右差"
          }
        }
      }
    },
    "左右波形相関は%@です。全体のSide/Mid比は%@、150 Hz以下は%@です。負の相関区間は%@です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
